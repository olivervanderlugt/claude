# Pseudonymisation root secret. MUST be >=32 chars; the server refuses to boot otherwise.
# A weak value here silently converts pseudonymous data into personal data and invalidates
# the entire privacy posture. Generate with: openssl rand -hex 32
PERCENTILE_ROOT_SECRET=

# Raw event retention in days. Erasure sweeps every pseudonym epoch in this window.
PERCENTILE_RETENTION_DAYS=400

PORT=8787

# MCP server — points a coding agent at your workspace.
PERCENTILE_ENDPOINT=https://api.percentile.dev
PERCENTILE_API_KEY=
