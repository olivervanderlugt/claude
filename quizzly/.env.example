# ─── Copy to `.env` and fill in. Never commit `.env`. ────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Public origin of the app. Used for CORS, WebSocket origin validation and
# absolute URLs. MUST be exact (scheme + host + port, no trailing slash).
APP_ORIGIN=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# docker-compose provides this automatically. For a managed Postgres, use the
# connection string it gives you and keep `sslmode=require`.
DATABASE_URL=postgresql://quizzly:quizzly@localhost:5432/quizzly?schema=public

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate each one separately with:  openssl rand -base64 32
# Rotating SESSION_SECRET logs everybody out; rotating it is the kill-switch
# if you ever suspect session tokens leaked.
SESSION_SECRET=replace-me-openssl-rand-base64-32

# Encrypts per-user API keys at rest (AES-256-GCM). Rotating this makes stored
# user keys unreadable — they simply have to re-enter them.
ENCRYPTION_KEY=replace-me-openssl-rand-base64-32

# ─── AI question generation (optional) ───────────────────────────────────────
# Leave blank and the app runs fine — the AI panel shows a "not configured"
# state and every other feature works. Drop a key in to switch it on; no code
# change and no redeploy of anything else is needed.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for generation. claude-opus-5 gives the best question quality;
# claude-sonnet-5 is cheaper and noticeably faster if you generate a lot.
AI_MODEL=claude-opus-5

# Hard ceiling on AI generations per user per hour. Protects your API bill.
AI_RATE_LIMIT_PER_HOUR=20

# ─── Realtime scaling (optional) ─────────────────────────────────────────────
# Only needed when you run MORE THAN ONE app instance. A single instance keeps
# game state in memory and needs no Redis at all. See docs/DEPLOYMENT.md.
REDIS_URL=

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_PLAYERS_PER_GAME=500
MAX_QUESTIONS_PER_QUIZ=100
